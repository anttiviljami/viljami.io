{
  "name": "viljami.io",
  "version": "2.0.0",
  "description": "Company site for Viljami.io / MRR Copilot Oy. Plain HTML + CSS, no build step.",
  "private": true,
  "scripts": {
    "start": "serve --listen 5173 --no-clipboard public",
    "dev": "serve --listen 5173 --no-clipboard public",
